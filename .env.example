AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate a secret with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (from https://console.cloud.google.com/)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RAG chat: run supabase/migrations/002_rag_lecture_chunks.sql in the Supabase SQL editor
# (pgvector + lecture_chunks). Embeddings use Amazon Titan (same AWS keys as Bedrock).

# Optional — comma-separated Piped-compatible API origins (tried in order; public defaults rotate).
# Strongly recommended in production when hosted on Vercel/AWS (YouTube often blocks datacenter transcript fetches).
# Each base must expose GET /streams/:videoId returning JSON with a subtitles[] array (TTML or VTT subtitle URLs).
# Instance list: https://github.com/TeamPiped/Piped/wiki/List-of-instances — prefer your own or a stable mirror.
# PIPED_BACKEND_URLS=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de
