AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate a secret with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (from https://console.cloud.google.com/)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RAG chat: run supabase/migrations/002_rag_lecture_chunks.sql in the Supabase SQL editor
# (pgvector + lecture_chunks). Embeddings use Amazon Titan (same AWS keys as Bedrock).
